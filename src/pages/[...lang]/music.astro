---
import Base from '../../layouts/Base.astro';
import LinkRow from '../../components/LinkRow.astro';
import { site, texts, djSchedule, playlists, t, langPaths, langOf, shortDate, todayIL } from '../../lib/content';

export const getStaticPaths = langPaths;
const lang = langOf(Astro.params.lang);
const T = texts.music;
const upcoming = djSchedule.filter((d) => d.date >= todayIL()).sort((a, b) => a.date.localeCompare(b.date));
---
<Base lang={lang} page="music" title={t(T.title, lang)} description={t(T.lead, lang)}>
  <div class="page grid">
    <div class="head">
      <h1>{t(T.title, lang)}</h1>
      <p class="lead">{t(T.lead, lang)}</p>
    </div>
    <div class="stack">
      <section class="block" aria-labelledby="dj-h">
        <h2 class="label" id="dj-h">{t(T.upcoming, lang)}</h2>
        <div class="rows" id="dj-list">
          {upcoming.map((d) => (
            <div class="row" data-until={d.date}>
              <span class="k">{shortDate(d.date, lang)}</span>
              <span class="v">{d.dj}{d.placeholder && <span class="tag">{t(texts.common.example, lang)}</span>}</span>
              <span class="x">{t(texts.common.party, lang)} {site.schedule.party}</span>
            </div>
          ))}
        </div>
        <p class="muted" data-empty-for="dj-list" hidden={upcoming.length > 0}>{t(T.none_upcoming, lang)}</p>
      </section>
      <section class="block" aria-labelledby="pl-h">
        <h2 class="label" id="pl-h">{t(T.playlists, lang)}</h2>
        <div class="rows lg">
          {playlists.map((p) => <LinkRow lang={lang} k={p.service} v={t(p, lang)} url={p.url} />)}
        </div>
      </section>
    </div>
  </div>
</Base>
