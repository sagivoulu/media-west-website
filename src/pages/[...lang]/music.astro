---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { texts, djSets, t, langPaths, langOf, shortDate } from '../../lib/content';

export const getStaticPaths = langPaths;
const lang = langOf(Astro.params.lang);
const T = texts.music;
// Newest first; sets without a date go last.
const sets = [...djSets].sort((a, b) => (b.date || '0').localeCompare(a.date || '0'));
const when = (d: string) => (d ? `${shortDate(d, lang)}${lang === 'he' ? '.' : ' '}${d.slice(0, 4)}` : '');
const service = (url: string) => (/spotify\.com/.test(url) ? 'Spotify' : /youtube|youtu\.be/.test(url) ? 'YouTube' : /soundcloud/.test(url) ? 'SoundCloud' : '');
const iconOf = (url: string) => (/spotify\.com/.test(url) ? 'spotify' : '');
---
<Base lang={lang} page="music" title={t(T.title, lang)} description={t(T.lead, lang)}>
  <div class="page grid">
    <div class="head">
      <h1>{t(T.title, lang)}</h1>
      <p class="lead">{t(T.lead, lang)}</p>
    </div>
    <section class="block" aria-labelledby="sets-h">
      <h2 class="label" id="sets-h">{t(T.sets, lang)}</h2>
      <div class="rows lg">
        {sets.map((s) => (
          <a class="row" href={s.url} target="_blank" rel="noopener">
            <span class="k">{when(s.date)}</span>
            <span class="v">{s.title ? <>{t(s.title, lang)}<span class="dot">·</span><wbr /><span class="muted nw">{s.dj}</span></> : <span class="nw">{s.dj}</span>}</span>
            <span class="x with-icon"><Icon name={iconOf(s.url)} />{service(s.url)}<span class="arrow" aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
    </section>
  </div>
</Base>
