---
// The Updates page was renamed to Socials (October 2026). Old links forward to the new address.
import { pageUrl, langPaths, langOf } from '../../lib/content';
export const getStaticPaths = langPaths;
const lang = langOf(Astro.params.lang);
const to = pageUrl('socials', lang);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(to, Astro.site).href} />
    <title>Media West</title>
  </head>
  <body><a href={to}>{to}</a></body>
</html>
