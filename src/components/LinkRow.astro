---
// A listing row that links out, or shows "coming soon" when the link isn't known yet.
import { texts, t, type Lang } from '../lib/content';
interface Props { lang: Lang; k: string; v: string; url?: string }
const { lang, k, v, url } = Astro.props;
const external = url && /^https?:/.test(url);
---
{url ? (
  <a class="row" href={url} {...(external ? { target: '_blank', rel: 'noopener' } : {})}>
    <span class="k">{k}</span><span class="v">{v}</span><span class="x arrow" aria-hidden="true">→</span>
  </a>
) : (
  <div class="row soon">
    <span class="k">{k}</span><span class="v">{v}</span><span class="x">{t(texts.common.soon, lang)}</span>
  </div>
)}
